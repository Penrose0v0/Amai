{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    " · 未授予套餐用量": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · plan usage not granted"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " · プランの利用が未許可"
          }
        }
      }
    },
    "%@\n尚未在 Amai 中验证抽取效果，可以使用，但结果可能不如已验证的模型。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nNot yet verified with Amai. You can use it, but results may be worse than verified models."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nAmai での抽出品質はまだ検証されていません。使えますが、検証済みのモデルより結果が劣る場合があります。"
          }
        }
      }
    },
    "%@\n请先安装 Claude Code，或在下方指定 claude 程序路径。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nInstall Claude Code first, or set the path to the claude program below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nClaude Code をインストールするか、下で claude プログラムのパスを指定してください。"
          }
        }
      }
    },
    "%@ API Key 已保存到钥匙串": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API key saved to Keychain"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API キーをキーチェーンに保存しました"
          }
        }
      }
    },
    "%@ · 间隔 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · every %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · 間隔 %2$@"
          }
        }
      }
    },
    "%@ – %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@"
          }
        }
      }
    },
    "%@ 中的系统区块标记不完整，为避免误删内容已停止写入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system block markers in %@ are incomplete; writing stopped to avoid deleting content"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のシステムブロックの記号が不完全なため、内容を誤って消さないよう書き込みを停止しました"
          }
        }
      }
    },
    "%@: 下载完成但权重不完整": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: download finished but the weights are incomplete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：ダウンロードは完了しましたが、重みが不完全です"
          }
        }
      }
    },
    "%@：请检查授权或接口配置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: check the authorization or API configuration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：認証または API の設定を確認してください"
          }
        }
      }
    },
    "%lld 分钟": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分"
          }
        }
      }
    },
    "%lld 块": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 台"
          }
        }
      }
    },
    "%lld 小时 %lld 分": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld h %2$lld min"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 時間 %2$lld 分"
          }
        }
      }
    },
    "%lld 秒": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld s"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒"
          }
        }
      }
    },
    "%lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%%"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%%"
          }
        }
      }
    },
    "%lld月%lld日": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld月%2$lld日"
          }
        }
      }
    },
    "%lld（其中画面重复 %lld）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld (%2$lld unchanged)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld（うち画面の重複 %2$lld）"
          }
        }
      }
    },
    "<html><meta charset=utf-8><body style='font-family:-apple-system;padding:40px'><h2>已完成授权</h2><p>可以关闭此页面，回到 Amai。</p></body></html>": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<html><meta charset=utf-8><body style='font-family:-apple-system;padding:40px'><h2>Authorization complete</h2><p>You can close this page and return to Amai.</p></body></html>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "<html><meta charset=utf-8><body style='font-family:-apple-system;padding:40px'><h2>認証が完了しました</h2><p>このページを閉じて Amai に戻ってください。</p></body></html>"
          }
        }
      }
    },
    "API": {},
    "API Key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キー"
          }
        }
      }
    },
    "API Key 无效或无权限：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid API key or no permission: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーが無効、または権限がありません：%@"
          }
        }
      }
    },
    "API 地址": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API URL"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API の URL"
          }
        }
      }
    },
    "Amai": {},
    "Amai 会在整理每日记录后自动写入。你也可以自己创建 %@ 并在里面书写。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai writes here after organizing your daily records. You can also create %@ yourself and write in it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai が日々の記録を整理したあとに自動で書き込みます。自分で %@ を作って書くこともできます。"
          }
        }
      }
    },
    "Amai 会在第二天凌晨 4 点后整理今天的记录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai organizes today's records after 4 AM tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai は翌日の午前 4 時以降に今日の記録を整理します。"
          }
        }
      }
    },
    "Amai 会记录什么": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Amai records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai が記録するもの"
          }
        }
      }
    },
    "Amai 住在菜单栏里，开始记录后会在后台安静运行。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai lives in the menu bar and runs quietly in the background once recording starts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai はメニューバーにいて、記録を始めるとバックグラウンドで静かに動きます。"
          }
        }
      }
    },
    "Amai 启动 claude -p，不启用任何工具，不加载你的全局配置与插件，也不读取或保存你的登录凭据。Anthropic 未对第三方应用以这种方式调用 Claude Code 作出明确许可，向他人分发包含此功能的版本前需要取得 Anthropic 的书面确认。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai runs claude -p with no tools enabled, without loading your global settings or plugins, and never reads or stores your login credentials. Anthropic has not explicitly permitted third-party apps to call Claude Code this way; get written confirmation from Anthropic before distributing a build with this feature."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai は claude -p を起動します。ツールは一切有効にせず、グローバル設定やプラグインも読み込まず、ログイン情報の読み取りや保存もしません。Anthropic はサードパーティアプリがこの方法で Claude Code を呼び出すことを明示的に許可していないため、この機能を含むバージョンを他人に配布する前に Anthropic の書面による確認が必要です。"
          }
        }
      }
    },
    "Amai 在后台记下你在电脑上做的事，并在本机整理成可以随时查看的时间线和长期记忆。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai notes what you do on your Mac in the background and organizes it, on this Mac, into a timeline and long-term memory you can look at any time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai はバックグラウンドで Mac での作業を記録し、この Mac 上でいつでも見返せるタイムラインと長期記憶に整理します。"
          }
        }
      }
    },
    "Amai 尚未开始记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai hasn't started recording"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai はまだ記録を始めていません"
          }
        }
      }
    },
    "Amai 已暂停记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai is paused"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai は記録を一時停止中"
          }
        }
      }
    },
    "Amai 整理的记忆": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curated by Amai"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai が整理した記憶"
          }
        }
      }
    },
    "Amai 无法启动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai couldn't start"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai を起動できません"
          }
        }
      }
    },
    "Amai 未在记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai is not recording"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai は記録していません"
          }
        }
      }
    },
    "Amai 根据屏幕活动推断，可能不准确": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inferred by Amai from screen activity; may be inaccurate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai が画面の活動から推測したもので、不正確な場合があります"
          }
        }
      }
    },
    "Amai 正在启动…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai is starting…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai を起動しています…"
          }
        }
      }
    },
    "Amai 正在记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai is recording"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai は記録中"
          }
        }
      }
    },
    "Amai 的总结": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai's summary"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai のまとめ"
          }
        }
      }
    },
    "Amai 的记忆整理请求会使用你的 ChatGPT 套餐额度。可以在 ChatGPT 设置中查看和管理用量。这与 Amai 自身的任何收费无关。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai's memory organization requests use your ChatGPT plan. You can view and manage usage in ChatGPT settings. This is unrelated to any charges from Amai itself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai の記憶整理のリクエストは ChatGPT プランの利用枠を使います。利用状況は ChatGPT の設定で確認・管理できます。Amai 自体の料金とは関係ありません。"
          }
        }
      }
    },
    "Amai 等待屏幕录制权限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai is waiting for screen recording permission"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai は画面収録の許可を待っています"
          }
        }
      }
    },
    "Amai 记录屏幕活动后，会在这里按时间显示。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once Amai records screen activity, it appears here in time order."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai が画面の活動を記録すると、ここに時間順で表示されます。"
          }
        }
      }
    },
    "Amai 记忆预览（只读示例数据）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai memory preview (read-only sample data)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai 記憶プレビュー（読み取り専用のサンプル）"
          }
        }
      }
    },
    "Amai 长期在后台运行，推荐常驻内存不超过本机三分之一的模型。下载只连接 Hugging Face。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai runs in the background for long periods, so it recommends a model that uses no more than a third of this Mac's memory. Downloads connect only to Hugging Face."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai は長時間バックグラウンドで動くため、常駐メモリがこの Mac の 3 分の 1 以下のモデルを推奨します。ダウンロードは Hugging Face にのみ接続します。"
          }
        }
      }
    },
    "Amai 需要屏幕录制权限才能看到屏幕上的内容。可以随时在系统设置中撤销。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amai needs Screen Recording permission to see what's on your screen. You can revoke it any time in System Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の内容を見るには画面収録の許可が必要です。システム設定からいつでも取り消せます。"
          }
        }
      }
    },
    "Anthropic（经 Claude Code）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic (via Claude Code)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic（Claude Code 経由）"
          }
        }
      }
    },
    "ChatGPT": {},
    "ChatGPT 拒绝了当前登录，请重新登录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT rejected the current sign-in; please sign in again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT が現在のログインを拒否しました。もう一度ログインしてください"
          }
        }
      }
    },
    "ChatGPT 登录已失效（%@），请重新登录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ChatGPT sign-in has expired (%@); please sign in again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT のログインが無効になりました（%@）。もう一度ログインしてください"
          }
        }
      }
    },
    "ChatGPT 登录已失效，请重新登录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ChatGPT sign-in has expired; please sign in again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT のログインが無効になりました。もう一度ログインしてください"
          }
        }
      }
    },
    "ChatGPT 订阅": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT subscription"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT サブスクリプション"
          }
        }
      }
    },
    "ChatGPT 账号": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT アカウント"
          }
        }
      }
    },
    "ChatGPT 账户状态无效，请重新登录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ChatGPT account status is invalid; please sign in again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT アカウントの状態が無効です。もう一度ログインしてください"
          }
        }
      }
    },
    "Claude Code 当前的登录方式是 %@，调用不会使用订阅额度。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code is currently signed in with %@, so calls won't use your subscription."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code の現在のログイン方法は %@ のため、呼び出しにサブスクリプションの利用枠は使われません。"
          }
        }
      }
    },
    "Claude Code 超过 %lld 秒未返回": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code didn't respond within %lld seconds"
          }
        },
        "ja": {
