            "value": "%lld 秒ごと"
          }
        }
      }
    },
    "每 %lld 秒截一次图，由本机模型理解后生成活动记录。原始截图最多保留 %lld 小时。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screenshot every %1$lld seconds, understood by an on-device model to create activity records. Raw screenshots are kept for at most %2$lld hours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 秒ごとにスクリーンショットを撮り、端末上のモデルが理解してアクティビティの記録を作ります。元のスクリーンショットは最長 %2$lld 時間だけ保持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "每 %1$lld 秒截一次图，由本机模型理解后生成活动记录。原始截图最多保留 %2$lld 小时。"
          }
        }
      }
    },
    "每个窗口的帧数 %lld 必须在 1 到 40 之间": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frames per window (%lld) must be between 1 and 40"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウあたりのフレーム数 %lld は 1〜40 にしてください"
          }
        }
      }
    },
    "每天凌晨 4 点后，Amai 会把前一天的记录整理进综合、工作、健康、财务、目标五个分区。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After 4 AM each day, Amai organizes the previous day's records into five areas: General, Work, Health, Finance and Goals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日午前 4 時以降、Amai は前日の記録を総合・仕事・健康・財務・目標の 5 つの分野に整理します。"
          }
        }
      }
    },
    "每日总结": {
      "localizations": {
